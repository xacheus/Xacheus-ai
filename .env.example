# ============================================================================
# VOICEPILOT AI — environment configuration
# Copy this file to `.env.local` and fill in the server-only values.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.
# On Vercel: Project Settings → Environment Variables (Production + Preview).
# Mark GROQ_API_KEY and FIREBASE_SERVICE_ACCOUNT_KEY as Sensitive. Redeploy
# after changing variables; a running deployment does not pick up edits.
# See docs/VERCEL.md. Do not paste secrets into chat or vercel.json.
# ============================================================================

# ---------------------------------------------------------------------------
# Firebase web configuration (PUBLIC — safe to ship to the browser).
# These defaults match the existing `xacheus-ai` project and are used when the
# variables below are absent. Override only if you move to another project.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCXKhOJYmmYz2Aqyv1powJuUaJHAySI87o
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xacheus-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xacheus-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xacheus-ai.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=381741784268
NEXT_PUBLIC_FIREBASE_APP_ID=1:381741784268:web:3d9e4f5b70a794c0bd3669

# Optional: Firebase App Check (reCAPTCHA v3 site key registered for the web app).
# Leave blank to run without App Check; enable enforcement in the console only
# after the site key is set here.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# ---------------------------------------------------------------------------
# SERVER ONLY — never prefix these with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Groq (AI text + Whisper speech-to-text)
GROQ_API_KEY=
# Current Groq production chat model (verified 2026-10-24 against
# console.groq.com/docs/models). llama-3.3-70b-versatile was retired for
# free/developer tiers on 2026-08-16 and is enterprise-only.
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Optional override for testing against a compatible gateway:
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Firebase Admin SDK — required for authenticated API routes, usage metering,
# call records and the admin dashboard.
# Paste the full service-account JSON on ONE line, or point to a file path.
FIREBASE_PROJECT_ID=xacheus-ai
FIREBASE_SERVICE_ACCOUNT_KEY=
# FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json

# Telephony (Twilio). Leave blank until the account is verified and ready.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS origin that Twilio can reach for webhooks (e.g. https://app.example.com)
TWILIO_WEBHOOK_BASE_URL=
# Set to "true" only after a full end-to-end test with a real verified number.
TELEPHONY_CALLING_ENABLED=false

# Server-side plan limits (monthly). These are defaults; see src/lib/plans.ts.
STARTER_TRANSCRIPTION_SECONDS=1800
STARTER_CHAT_REQUESTS=100
STARTER_AGENTS=1

# Rate limiting (in-memory per instance; replace with Redis for multi-region).
RATE_LIMIT_TRANSCRIBE_PER_HOUR=30
RATE_LIMIT_CHAT_PER_HOUR=120
